# HTTP server
# HOST=127.0.0.1
# UPTIME_WEBAPP_PORT=4175

# Storage (defaults to ./data/)
# UPTIME_WEBAPP_JOBS_DATA=./data/jobs.json
# UPTIME_WEBAPP_HISTORY_DATA=./data/history.jsonl

# IPFS publishing monitor target (IP address or hostname)
# IPFS_PUBLISHING_HOST=
# IPFS_PUBLISHING_PORT=4001

# Remote TCP check used by the IPFS publishing monitor
# IPFS_UPTIME_SSH_HOST=admin@uptime-vps.example.com
# IPFS_UPTIME_SSH_KEY_PEM=/path/to/private-key.pem
